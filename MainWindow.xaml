<Window x:Class="PDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDM" xmlns:viewmodels="clr-namespace:PDM.Src.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:DatabaseManagerViewModel}"
        mc:Ignorable="d"
        Title="Phone Database Manager" Height="650" Width="1200" UseLayoutRounding="True">
    <Window.Resources>
        
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TextNormalBrush}">
            <Menu>
                <MenuItem Header="File" Foreground="{DynamicResource TextNormalBrush}">
                    <MenuItem Header="Create New DB" Command="{Binding CreateNewCommand}"></MenuItem>
                    <MenuItem Header="Open DB" Command="{Binding OpenCommand}"></MenuItem>
                </MenuItem>
            </Menu>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BackgroundPrimaryAltBrush}" BorderBrush="{DynamicResource TextNormalBrush}" BorderThickness="0,1,0,0">
            <Grid UseLayoutRounding="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged" Background="{DynamicResource BackgroundSecondaryBrush}">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"></Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Content="Dashboard" Tag="DashboardPage" Foreground="{DynamicResource TextNormalBrush}"></ListBoxItem>
                    <ListBoxItem Content="Phone List" IsEnabled="{Binding IsDatabaseAvailable}" Tag="PhoneListPage" Foreground="{DynamicResource TextNormalBrush}"></ListBoxItem>
                    <ListBoxItem Content="Add Phone" Tag="AddPhonePage" IsEnabled="{Binding IsDatabaseAvailable}" Foreground="{DynamicResource TextNormalBrush}"></ListBoxItem>
                    <ListBoxItem Content="Identify Phone" Tag="IdPhonePage" IsEnabled="{Binding IsDatabaseAvailable}" Foreground="{DynamicResource TextNormalBrush}"></ListBoxItem>
                    <ListBoxItem Content="Settings" Tag="SettingsPage" Foreground="{DynamicResource TextNormalBrush}"></ListBoxItem>
                    <ListBoxItem Content="Admin Page" Tag="AdminPage" IsEnabled="{Binding IsDatabaseAvailable}" Foreground="{DynamicResource TextNormalBrush}"></ListBoxItem>
                    <ListBoxItem Content="About" Tag="AboutPage" Foreground="{DynamicResource TextNormalBrush}"></ListBoxItem>
                </ListBox>
               

                <Frame Grid.Column="1" x:Name="MainFrame"></Frame>
                
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource TextNormalBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Current Database Loaded: " Foreground="{DynamicResource TextNormalBrush}"></TextBlock>
                    <TextBlock Text="{Binding Path}" FontWeight="Bold" Foreground="{DynamicResource TextNormalBrush}"></TextBlock>
                </StackPanel>

                <StackPanel Margin="10" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Back" Click="NavToPrevPage_Click" Margin="0,0,10,0" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}" Width="70">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                    <Button Content="Next" Click="NavToNextPage_Click" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}" Width="70">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
            
        </Border>
        
    </Grid>
</Window>
