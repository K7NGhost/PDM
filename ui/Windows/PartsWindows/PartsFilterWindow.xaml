<Window x:Class="PDM.ui.Windows.PartsFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDM.ui.Windows" xmlns:partsvm="clr-namespace:PDM.Src.ViewModels.PartsVM" d:DataContext="{d:DesignInstance Type=partsvm:AddPartsViewModel}"
        mc:Ignorable="d"
        Title="PartsFilterWindow" Height="330" Width="550">
    <Grid Background="{DynamicResource BackgroundPrimaryAltBrush}">
        <Border BorderBrush="{DynamicResource TextNormalBrush}" BorderThickness="1" Padding="20" CornerRadius="20" Margin="10" Background="{DynamicResource BackgroundSecondaryBrush}">
            <StackPanel Margin="5" UseLayoutRounding="True">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Brand:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextNormalBrush}"></TextBlock>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}">
                        <ComboBox.Effect>
                            <DropShadowEffect/>
                        </ComboBox.Effect>
                    </ComboBox>
                </Grid>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Model:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextNormalBrush}"></TextBlock>

                    <ComboBox ItemsSource="{Binding FilteredModels}" Grid.Column="1" SelectedItem="{Binding SelectedPart.Model}" Foreground="{DynamicResource TextNormalBrush}" BorderBrush="{DynamicResource TextNormalBrush}">
                        <ComboBox.Effect>
                            <DropShadowEffect></DropShadowEffect>
                        </ComboBox.Effect>
                    </ComboBox>
                </Grid>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="4*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Part Type:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextNormalBrush}"></TextBlock>
                    <ComboBox ItemsSource="{Binding PartTypes}" SelectedItem="{Binding SelectedPartType}" Grid.Column="1" Foreground="{DynamicResource TextNormalBrush}" BorderBrush="{DynamicResource TextNormalBrush}">
                        <ComboBox.Effect>
                            <DropShadowEffect/>
                        </ComboBox.Effect>
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,20,10,10">
                    <Button Content="Apply" Width="75" Margin="0,0,10,0" Click="Apply_Click" Foreground="{DynamicResource TextNormalBrush}" BorderBrush="{DynamicResource TextNormalBrush}">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                    <Button Content="Cancel" Width="75" Click="Cancel_Click" Margin="10,0,0,0" Foreground="{DynamicResource TextNormalBrush}" BorderBrush="{DynamicResource TextNormalBrush}">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
