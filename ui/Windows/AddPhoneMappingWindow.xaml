<Window x:Class="PDM.ui.Windows.AddPhoneMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDM.ui.Windows" xmlns:viewmodels="clr-namespace:PDM.Src.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:PhoneLookupViewModel}"
        mc:Ignorable="d"
        Title="Add Record" Height="450" Width="400">
    <Grid Background="{DynamicResource BackgroundPrimaryAltBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Manufacturer ID -->
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="Manufacturer ID:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource TextNormalBrush}"/>
            <TextBox Text="{Binding SelectedItem.ManufacturerId}" Width="200"/>
        </StackPanel>

        <!-- Brand -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
            <TextBlock Text="Brand:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource TextNormalBrush}"/>
            <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedItem.Brand}" Width="200"></ComboBox>
        </StackPanel>

        <!-- Model -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10">
            <TextBlock Text="Model:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource TextNormalBrush}"/>
            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedItem.Model}" Width="200"></ComboBox>
        </StackPanel>

        <!-- Release Year -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="10">
            <TextBlock Text="Release Year:" Width="120" VerticalAlignment="Center" Foreground="{DynamicResource TextNormalBrush}"/>
            <TextBox Text="{Binding SelectedItem.ReleaseYear}" Width="200"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Save" Width="80" Margin="0,0,10,0" IsDefault="True" Foreground="{DynamicResource TextNormalBrush}" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Foreground="{DynamicResource TextNormalBrush}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
