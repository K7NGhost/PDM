<Window x:Class="PDM.ui.Windows.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDM.ui.Windows"
        mc:Ignorable="d"
        Title="AdminLoginWindow" Height="450" Width="800">
    <Grid Background="{DynamicResource BackgroundPrimaryAltBrush}">
        <StackPanel>
            <TextBlock Text="Enter Admin Password:" FontWeight="Bold" Margin="0,0,0,10"></TextBlock>
            <PasswordBox x:Name="PasswordInput" Height="30" Margin="0,0,0,20"></PasswordBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="80" Margin="0,0,10,0" Click="Ok_Click"></Button>
                <Button Content="Cancel" Width="80" Click="Cancel_Click"></Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
