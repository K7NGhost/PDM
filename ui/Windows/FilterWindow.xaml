<Window x:Class="PDM.ui.Windows.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDM.ui.Windows"
        xmlns:viewmodels="clr-namespace:PDM.Src.ViewModels;assembly=PDM" d:DataContext="{d:DesignInstance Type=viewmodels:PhoneDataViewModel}"
        mc:Ignorable="d"
        Title="FilterWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Brand:" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <ComboBox ItemsSource="{Binding Brands}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Model:" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <ComboBox ItemsSource="{Binding Models}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OS:" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <ComboBox ItemsSource="{Binding OSes}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Condition:" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <ComboBox ItemsSource="{Binding PhoneConditions}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Phone State:" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <ComboBox ItemsSource="{Binding PhoneStates}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Phone Status:" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <ComboBox ItemsSource="{Binding PhoneStatuses}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Passcode Type:" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <ComboBox ItemsSource="{Binding PasscodeTypes}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Passcode Length:" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <TextBlock></TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Apply" Width="75" Margin="0,0,10,0" Click="Apply_Click"></Button>
                <Button Content="Cancel" Width="75" Click="Cancel_Click"></Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
