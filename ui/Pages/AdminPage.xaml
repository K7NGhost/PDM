<Page x:Class="PDM.ui.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDM.ui.Pages" xmlns:viewmodels="clr-namespace:PDM.Src.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:AdminPageViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid Background="{DynamicResource BackgroundPrimaryAltBrush}">
        <StackPanel Margin="20">

            <TextBlock Text="Phone Brand:" Foreground="{DynamicResource TextNormalBrush}"/>
            <TextBox Text="{Binding BrandInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

            <TextBlock Text="Phone Model:" Foreground="{DynamicResource TextNormalBrush}"/>
            <TextBox Text="{Binding ModelInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

            <TextBlock Text="Phone OS:" Foreground="{DynamicResource TextNormalBrush}"/>
            <TextBox Text="{Binding OSInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

            <Button Content="Save to Database"
                Command="{Binding SaveCommand}"
                Margin="0,10" Foreground="{DynamicResource TextNormalBrush}"/>
        </StackPanel>
    </Grid>
</Page>
