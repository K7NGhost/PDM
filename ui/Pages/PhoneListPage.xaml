<Page x:Class="PDM.ui.PhoneListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDM.ui" xmlns:viewmodels="clr-namespace:PDM.Src.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:PhoneListViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1000"
      Title="PhoneList" UseLayoutRounding="True">

    <Page.Resources>
        <Style x:Key="DataGridWrappedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource BackgroundPrimaryAltBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
                    <Button Content="Filter By" Command="{Binding OpenFilterCommand}" Foreground="{DynamicResource TextNormalBrush}" Width="150" BorderBrush="{DynamicResource TextNormalBrush}" Margin="0,0,20,0">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                    <Button Content="Clear Filters" Command="{Binding ClearFilterCommand}" Width="100" Foreground="{DynamicResource TextNormalBrush}" BorderBrush="{DynamicResource TextNormalBrush}" Margin="0,0,20,0">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                    <Button Content="Show Group Mapping" Command="{Binding ShowGroupMappingCommand}" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,20,0">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>

                    <TextBlock Text="Sort By: " VerticalAlignment="Center" Foreground="{DynamicResource TextNormalBrush}" Margin="20,0,10,0" FontWeight="Bold"></TextBlock>
                    <ComboBox ItemsSource="{Binding SortDirection}" SelectedItem="{Binding SelectedSortDirection, Mode=TwoWay}" Margin="0,0,20,0" Width="125" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}">
                        <ComboBox.Effect>
                            <DropShadowEffect/>
                        </ComboBox.Effect>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding SortColumns}" SelectedItem="{Binding SelectedSortColumn, Mode=TwoWay}" Width="140" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,20,0">
                        <ComboBox.Effect>
                            <DropShadowEffect/>
                        </ComboBox.Effect>
                    </ComboBox>

                    <Button Content="Select columns" Click="SelectColumns_Click" Foreground="{DynamicResource TextNormalBrush}" BorderBrush="{DynamicResource TextNormalBrush}">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>

                    
                </StackPanel>
                
            </Grid>
        </Border>

        <DataGrid x:Name="PhoneGrid" Grid.Row="1" AutoGenerateColumns="False" ColumnWidth="*" CanUserAddRows="False" ItemsSource="{Binding Phones}" HorizontalContentAlignment="Center" IsReadOnly="True" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}" Margin="10" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <!-- Put the VM on the row.Tag -->
                    <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Edit" Command="{Binding PlacementTarget.Tag.EditPhoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeletePhoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"></MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Image" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Image Source="{Binding ImagePreviewBack}" Stretch="Fill" MaxWidth="250" MaxHeight="100"></Image>
                                <Image Source="{Binding ImagePreviewFront}" Stretch="Fill" MaxWidth="250" MaxHeight="100"></Image>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Group Id" Binding="{Binding GroupId}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="OS" Binding="{Binding OS}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Device Type" Binding="{Binding DeviceType}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="PasscodeType" Binding="{Binding PasscodeType}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="PasscodeLength" Binding="{Binding PasscodeLength}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="PhoneState" Binding="{Binding PhoneState}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Man Id" Binding="{Binding ManufacturerId}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>

                <DataGridTextColumn Header="Color" Binding="{Binding Color}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource TextNormalBrush}" BorderThickness="1" Margin="10" CornerRadius="10" Background="{DynamicResource BackgroundSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Page:" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextNormalBrush}"></TextBlock>
                    <TextBlock Text="{Binding CurrentPage}" Margin="5" Foreground="{DynamicResource TextNormalBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                    <TextBlock Text="/" Foreground="{DynamicResource TextNormalBrush}" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Margin="5" Text="{Binding TotalPages}" Foreground="{DynamicResource TextNormalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

                    <Button Content="Back" Foreground="{DynamicResource TextNormalBrush}" Margin="40,0,10,0" Command="{Binding PreviousPageCommand}"></Button>
                    <Button Content="Next" Foreground="{DynamicResource TextNormalBrush}" Command="{Binding NextPageCommand}"></Button>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="Total Items: " FontWeight="Bold" Foreground="{DynamicResource TextNormalBrush}"/>
                    <TextBlock Text="{Binding TotalItems}" Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,40,0"/>
                </StackPanel>
            </Grid>
            
        </Border>
    </Grid>
    
</Page>
