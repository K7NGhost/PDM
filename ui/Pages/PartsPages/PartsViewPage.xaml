<Page x:Class="PDM.ui.Pages.PartsViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDM.ui.Pages" xmlns:partsvm="clr-namespace:PDM.Src.ViewModels.PartsVM" d:DataContext="{d:DesignInstance Type=partsvm:PartsListViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="PartsViewPage"
      UseLayoutRounding="True">
    <Page.Resources>
        <Style x:Key="DataGridWrappedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </Page.Resources>
    <Grid Background="{DynamicResource BackgroundPrimaryAltBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
                    <Button Content="Filter By" Command="{Binding OpenFilterWindowCommand}" Foreground="{DynamicResource TextNormalBrush}" Width="150" BorderBrush="{DynamicResource TextNormalBrush}" Margin="0,0,20,0">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                    <Button Content="Clear Filters" Width="100" Foreground="{DynamicResource TextNormalBrush}" BorderBrush="{DynamicResource TextNormalBrush}" Command="{Binding ClearFiltersCommand}" Margin="0,0,20,0">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>
                    <Button Content="Show Group Mapping" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,20,0">
                        <Button.Effect>
                            <DropShadowEffect/>
                        </Button.Effect>
                    </Button>

                    <TextBlock Text="Sort By: " VerticalAlignment="Center" Foreground="{DynamicResource TextNormalBrush}" Margin="20,0,10,0" FontWeight="Bold"></TextBlock>
                    <ComboBox Margin="0,0,20,0" ItemsSource="{Binding SortDirection}" SelectedItem="{Binding SelectedSortDirection, Mode=TwoWay}" Width="125" BorderBrush="{DynamicResource TextNormalBrush}" Foreground="{DynamicResource TextNormalBrush}">
                        <ComboBox.Effect>
                            <DropShadowEffect/>
                        </ComboBox.Effect>
                    </ComboBox>
                    <ComboBox Width="140" BorderBrush="{DynamicResource TextNormalBrush}" ItemsSource="{Binding SortColumns}" SelectedItem="{Binding SelectedSortColumn, Mode=TwoWay}" Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,20,0">
                        <ComboBox.Effect>
                            <DropShadowEffect/>
                        </ComboBox.Effect>
                    </ComboBox>


                </StackPanel>

            </Grid>
        </Border>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" ColumnWidth="*" CanUserAddRows="False" ItemsSource="{Binding Parts}" Background="{DynamicResource BackgroundSecondaryBrush}" Margin="10" Foreground="{DynamicResource TextNormalBrush}" BorderBrush="{DynamicResource TextNormalBrush}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"></Setter>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Edit" Command="{Binding PlacementTarget.Tag.OpenEditWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"></MenuItem>
                                <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeletePartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"></MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Image" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePreview}" Stretch="Fill" MaxHeight="100" MaxWidth="250"></Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Group Id" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}" Binding="{Binding GroupId}"></DataGridTextColumn>
                <DataGridTextColumn Header="Id" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}" Binding="{Binding Id}"></DataGridTextColumn>
                <DataGridTextColumn Header="Part Type" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}" Binding="{Binding PartType}"></DataGridTextColumn>
                <DataGridTextColumn Header="Brand" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}" Binding="{Binding Brand}"></DataGridTextColumn>
                <DataGridTextColumn Header="Model" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}" Binding="{Binding Model}"></DataGridTextColumn>
                <DataGridTextColumn Header="Notes" ElementStyle="{StaticResource DataGridWrappedTextBlockStyle}" Binding="{Binding Notes}"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource TextNormalBrush}" BorderThickness="1" Margin="10" CornerRadius="10" Background="{DynamicResource BackgroundSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Page:" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextNormalBrush}"></TextBlock>
                    <TextBlock Text="{Binding CurrentPage}" Margin="5" Foreground="{DynamicResource TextNormalBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                    <TextBlock Text="/" Foreground="{DynamicResource TextNormalBrush}" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Margin="5" Text="{Binding TotalPages}" Foreground="{DynamicResource TextNormalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

                    <Button Content="Back" Foreground="{DynamicResource TextNormalBrush}" Margin="40,0,10,0"></Button>
                    <Button Content="Next" Foreground="{DynamicResource TextNormalBrush}"></Button>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="Total Items: " FontWeight="Bold" Foreground="{DynamicResource TextNormalBrush}"/>
                    <TextBlock Text="{Binding TotalItems}" Foreground="{DynamicResource TextNormalBrush}" Margin="0,0,40,0"/>
                </StackPanel>
            </Grid>

        </Border>
    </Grid>
</Page>
