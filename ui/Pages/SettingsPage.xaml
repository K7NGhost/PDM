<Page x:Class="PDM.ui.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDM.ui.Pages" xmlns:viewmodels="clr-namespace:PDM.Src.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage">

    <Grid Background="{DynamicResource BackgroundPrimaryAltBrush}">
        <Border BorderBrush="{DynamicResource TextNormalBrush}" Background="{DynamicResource BackgroundSecondaryBrush}" BorderThickness="1" CornerRadius="10" Margin="10" Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Theme: " Foreground="{DynamicResource TextNormalBrush}" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center"></TextBlock>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"></ComboBox>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
