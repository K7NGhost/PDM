<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#FFFFFFFF"/>
    <!-- Pure white -->
    <SolidColorBrush x:Key="BackgroundPrimaryAltBrush" Color="#FFF5F5F5"/>
    <!-- Light gray -->
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#FFEEEEEE"/>
    <!-- Slightly darker gray -->
    <SolidColorBrush x:Key="BackgroundSecondaryAltBrush" Color="#FFE0E0E0"/>
    <!-- Even darker gray -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextNormalBrush" Color="#FF000000"/>
    <!-- Black text -->
    <SolidColorBrush x:Key="TitlebarTextColorFocusedBrush" Color="#FF1E88E5"/>
    <!-- Blue accent (like Windows titlebar) -->

</ResourceDictionary>