<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#212121"/>
    <!-- Almost black background -->
    <SolidColorBrush x:Key="BackgroundPrimaryAltBrush" Color="#FF2A2A2A"/>
    <!-- Dark gray alternative background -->
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#181818"/>
    <!-- Slightly lighter dark gray -->
    <SolidColorBrush x:Key="BackgroundSecondaryAltBrush" Color="#FF3C3C3C"/>
    <!-- Medium dark gray -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextNormalBrush" Color="#FFFFFFFF"/>
    <!-- White text -->
    <SolidColorBrush x:Key="TitlebarTextColorFocusedBrush" Color="#FF4FC3F7"/>
    <!-- Light blue accent (Windows-like) -->
</ResourceDictionary>